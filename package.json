    "typecheck": "tsc -p .",
    "build": "bun build --compile src/main.ts --outfile dist/hqterm"
  },
  "dependencies": {
    "@profullstack/hqtui": "^0.10.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
